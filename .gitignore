# Real or private logs must never be committed. Only the synthetic files are tracked:
#   data/sample_logs_synthetic.csv
#   evaluation/eval_logs_synthetic.csv
/*.csv
data/*
!data/sample_logs_synthetic.csv
*.private.csv
